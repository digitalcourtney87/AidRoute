# Copy to .env.local and fill in. Server routes only — never exposed to the client.
ANTHROPIC_API_KEY=

# --- Persistence (optional) -------------------------------------------------
# Leave ALL of these unset for the offline in-memory mode — the rehearsed
# demo path. Set both SUPABASE_* vars to switch the claim store to Supabase
# (persistent, shared across serverless instances). Service-role key only;
# there is no client-side Supabase access.
# Paste each value once, on a single line. A duplicated paste or extra
# newlines makes the Authorization header invalid and takes the store down.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# When set, /api/reset requires this value in an x-admin-token header (or
# Authorization bearer). Unset = reset stays open (local dev / demo machine).
ADMIN_TOKEN=

# Set in Vercel (not locally): Vercel sends it as a bearer token with the
# nightly reseed cron (vercel.json). Use any long random string.
CRON_SECRET=
